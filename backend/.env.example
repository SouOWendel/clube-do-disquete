# define as chaves e configuracoes basicas de execucao do Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# define os dados de conexao com o banco PostgreSQL do projeto
DB_NAME=disquete_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# define o endereco do Redis usado para guardar os tokens revogados no logout (docker compose sobe em localhost:6379)
REDIS_URL=redis://localhost:6379/0

# define as origens permitidas para requisicoes vindas do Angular e do Electron
CORS_ALLOWED_ORIGINS=http://localhost:4200

# define a chave de assinatura e os tempos de expiracao em minutos do token de acesso (24 horas) e de recuperacao de senha (30 minutos)
JWT_SECRET_KEY=
JWT_ACCESS_EXPIRES_MINUTES=1440
JWT_RESET_EXPIRES_MINUTES=30

# define o identificador de cliente do Google usado para validar tokens de acesso social
GOOGLE_CLIENT_ID=

# define as configuracoes de envio de email usadas no fluxo de recuperacao de senha
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@clubedodisquete.local
FRONTEND_RESET_PASSWORD_URL=http://localhost:4200/redefinir-senha