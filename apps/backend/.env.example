# configuracoes do Django
# gere uma chave aleatoria com: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=troque-por-uma-chave-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# conexao com o banco PostgreSQL disquete_db
DB_NAME=disquete_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# origens liberadas para o cliente desktop (Angular + Electron), separadas por virgula
CORS_ALLOWED_ORIGINS=http://localhost:4200

# parametros dos tokens jwt
JWT_SECRET_KEY=troque-por-outra-chave-aleatoria
JWT_ACCESS_EXPIRES_MINUTES=1440
