{
  "name": "clube-do-disquete",
  "productName": "clube-do-disquete",
  "version": "1.0.0",
  "private": true,
  "description": "Fórum desktop retrô sobre hardware e tecnologia",
  "keywords": [],
  "license": "MIT",
  "author": {
    "name": "SouOWendel",
    "email": "souowendel@gmail.com"
  },
  "main": ".vite/build/main.cjs",
  "scripts": {
    "start": "concurrently -k -n angular,electron -c magenta,cyan \"npm --prefix renderer start\" \"wait-on tcp:localhost:4200 && electron-forge start\"",
    "package": "npm run build:renderer && electron-forge package",
    "make": "npm run build:renderer && electron-forge make",
    "lint": "oxlint && oxfmt --check --ignore-path=../.gitignore",
    "lint:fix": "oxlint --fix && oxfmt --write --ignore-path=../.gitignore",
    "typecheck": "tsc --noEmit",
    "build:renderer": "npm --prefix renderer run build",
    "postinstall": "npm --prefix renderer install"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@types/electron-squirrel-startup": "^1.0.2",
    "concurrently": "^10.0.7",
    "electron": "45.3.2",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.93.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "wait-on": "^9.5.1"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1"
  }
}
